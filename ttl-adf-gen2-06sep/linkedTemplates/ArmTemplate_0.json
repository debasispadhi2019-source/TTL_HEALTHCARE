		"sql_ls_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'sql_ls'"
		},
		"ttl_raw_sql_ls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ttl_raw_sql_ls'"
		},
		"LS_DATABSE_A_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "tthcemr06sep.database.windows.net"
		},
		"LS_DATABSE_A_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "trendy-tech-hospital-b"
		},
		"LS_DATABSE_A_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"sql_ls_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "tthcemr06sep.database.windows.net"
		},
		"sql_ls_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "trendy-tech-hospital-a"
		},
		"sql_ls_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"ttl_raw_sql_ls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://ttadlsdev06sep.dfs.core.windows.net/"
