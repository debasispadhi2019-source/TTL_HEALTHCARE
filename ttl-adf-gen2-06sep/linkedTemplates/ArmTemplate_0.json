				"parameters": {
					"table_nam": {
						"type": "string"
					}
				},
				"folder": {
					"name": "SOUCE_SQL"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [],
				"typeProperties": {
					"schema": "dbo",
					"table": {
						"value": "@dataset().table_nam",
						"type": "Expression"
					}
				}
